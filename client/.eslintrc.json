{
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react/jsx-runtime",
    "plugin:react-hooks/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "plugins": [
    "react-refresh"
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    "postcss.config.js",
    "tailwind.config.js"
  ],
  "rules": {
    "react-refresh/only-export-components": "off",
    "react/prop-types": "off",
    "no-unused-vars": "off",
    "react/no-unescaped-entities": "off",
    "react-hooks/exhaustive-deps": "off",
    "react/react-in-jsx-scope": "off",
    "no-undef": "off",
    "no-prototype-builtins": "off",
    "react/display-name": "off",
    "no-empty": "off",
    "no-func-assign": "off"
  }
}
